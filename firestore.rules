rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    // Jeder Haushalt liegt unter households/<CODE>/...
    // Zugriff nur für angemeldete App-Nutzer, die den 12-stelligen Code kennen.
    // Die Liste aller Haushalte kann niemand abrufen.
    match /households/{hid}/{document=**} {
      allow read, write: if request.auth != null && hid.size() == 14;
    }
  }
}
